#!/usr/bin/env bats

# Test with the debug build of `lai`.

lai=./lai

@test "Detect Bourne Shell by Suffix" {
    result="$($lai scripts/hello.sh | head -n1)";
    echo "$result" | fgrep "Bourne";
    [ $? -eq 0 ];
}

@test "Detect Bourne Shell by Shebang" {
    result="$($lai scripts/helloInSh | head -n1)";
    echo "$result" | fgrep "Bourne";
    [ $? -eq 0 ];
}

@test "Detect Perl by Suffix" {
    result="$($lai scripts/hello.pl | head -n1)";
    echo "$result" | fgrep "Perl";
    [ $? -eq 0 ];
}

@test "Detect Perl by Shebang" {
    result="$($lai scripts/helloInPerl | head -n1)";
    echo "$result" | fgrep "Perl";
    [ $? -eq 0 ];
}

@test "Detect Python by Suffix" {
    result="$($lai scripts/hello.py | head -n1)";
    echo "$result" | fgrep "Python";
    [ $? -eq 0 ];
}

@test "Detect Python by Shebang" {
    result="$($lai scripts/helloInPython | head -n1)";
    echo "$result" | fgrep "Python";
    [ $? -eq 0 ];
}

