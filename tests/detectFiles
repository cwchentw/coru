#!/usr/bin/env bats

# Test with the debug build of `lai`.

lai=./lai

_check_tool_exists ()
{
    local tool=$1;

    if [ -z "$tool" ];
    then
        echo "No valid tool" >&2;
        exit 1;
    fi

    if ! command -v $tool 2>/dev/null 1>&2;
    then
        echo "No $tool installed on your system" >&2;
        exit 1;
    fi
}

_check_tool_exists sh;
_check_tool_exists csh;
_check_tool_exists perl;
_check_tool_exists python;
_check_tool_exists ruby;
_check_tool_exists php;

unset -f _check_tool_exists;

@test "Detect Bourne Shell by Suffix" {
    result="$($lai scripts/hello.sh | head -n1)";
    echo "$result" | fgrep "Bourne";
    [ $? -eq 0 ];
}

